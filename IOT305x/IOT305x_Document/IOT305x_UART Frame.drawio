        <mxCell id="Y5IgDsyA5UMn8laPzqXE-27" value="(8) Sequence number:&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Each time a message is sent, this field will increment by 1&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;container=0;" vertex="1" parent="Y5IgDsyA5UMn8laPzqXE-1">
